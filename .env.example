# 任意。通常は未設定のままにし、Sitesは現在の本番URL、Vercelは
# 目標の https://mon-ai.jp/aijuku を自動で使います。公開先を明示的に
# 上書きする場合だけ、末尾スラッシュなしの絶対URLを設定します。
NEXT_PUBLIC_SITE_URL=

# Sitesの実行環境だけに設定。申込者情報を含む全運用を扱うオーナーを指定します。
# 実在メールアドレスや秘密情報をこの見本へ書かないでください。
ADMIN_EMAILS=

# 講師確認だけを行うメール。申込者のメールや申込管理は表示されません。
INSTRUCTOR_EMAILS=

# Sitesの実行環境だけに設定する認証秘密値。32文字以上の十分に長い乱数を使い、
# Git、マイグレーション、スクリーンショットへ残さないでください。
AUTH_PASSWORD_PEPPER=

# 塾のログインIDと、管理者のChatGPT本人確認メールが異なる場合だけ設定します。
# ADMIN_EMAILSに含まれる本人だけが、このログインIDの初回連携を行えます。
AUTH_OWNER_LOGIN_ID=

# パスワード認証で運営権限を与える既存会員の不変IDです。Sitesの秘密値として
# 設定し、AUTH_OWNER_LOGIN_IDとの両方が一致した時だけ運営権限を有効にします。
AUTH_OWNER_MEMBER_ID=

# Google Calendar APIのWeb OAuthクライアント。実値はSitesの秘密環境値にだけ設定します。
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 予定を保存する運営者本人のGoogleメールと、更新用トークン・Meet URLを
# 暗号化する専用鍵。鍵は64文字の16進数または32バイトのBase64 URL形式を使います。
GOOGLE_CALENDAR_OWNER_EMAIL=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Stripeは現在サンドボックス専用です。`test`を設定した時だけ、
# 確定済み申込からStripe-hosted Checkoutを開きます。
STRIPE_BILLING_MODE=

# 利用するStripeサンドボックスのアカウントID。実値はSitesの実行環境にだけ設定します。
STRIPE_ACCOUNT_ID=

# Sitesの秘密環境変数にだけ設定します。可能な限り最小権限の
# `rk_test_`制限付きキーを使い、チャットやGitに実値を残しません。
STRIPE_SECRET_KEY=

# `/api/billing/webhook`用のテストWebhook署名シークレット。
STRIPE_WEBHOOK_SECRET=
