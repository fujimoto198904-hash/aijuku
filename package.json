{
  "name": "toyota-ai-school",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "doctor": "node scripts/doctor.mjs",
    "verify": "npm run doctor && npm run check:catalog && npm run check:lessons && npm run check:access && npm run check:auth && npm run check:docs && npm run check:demo-data && npm run build",
    "build:catalog": "node scripts/build_textbook_catalog.mjs",
    "build:lessons": "tsx scripts/check_textbook_lessons.ts --write && tsx scripts/build_lesson_meta.ts",
    "check:catalog": "node scripts/build_textbook_catalog.mjs --check",
    "check:lessons": "tsx scripts/check_textbook_lessons.ts && tsx scripts/build_lesson_meta.ts --check",
    "check:access": "tsx scripts/check_textbook_access.ts",
    "check:auth": "tsx scripts/check_auth_security.ts",
    "check:demo-data": "node scripts/check_demo_data.mjs && tsx scripts/build_demo_task_download_plan.ts --check && python3 scripts/extract_demo_direct_files.py --check",
    "build:guide": "python3 scripts/build_start_guide.py",
    "build:brand-og": "node scripts/build_brand_og.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/apply_local_migrations.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:demo-index": "python3 scripts/build_demo_file_index.py && tsx scripts/build_demo_task_download_plan.ts && python3 scripts/extract_demo_direct_files.py",
    "check:docs": "node scripts/check_docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
